# Optional. Without DATABASE_URL, use embedded PostgreSQL in .khala/.
# DATABASE_URL=postgresql://user:password@localhost:5432/khala

# Optional server-wide fallback. Users can configure keys in Settings.
# LLM_PROVIDER=openai
# LLM_MODEL=your-model-id
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_OUTPUT_MODE=schema
# For production, set the externally visible origin and use HTTPS cookies.
# APP_ORIGIN=https://khala.example.com
# SESSION_COOKIE_SECURE=true
# Local HTTP production smoke only: SESSION_COOKIE_SECURE=false
# Required with DATABASE_URL. Generate once, store securely, retain across restarts.
# KHALA_ENCRYPTION_KEY=<base64-encoded 32 random bytes>
# Additional approved OpenAI-compatible API origins, comma separated.
# KHALA_ALLOWED_API_ORIGINS=http://192.168.1.10:8000,https://llm.example.com
# Optional Python executable for local RAG embedding inference.
# KHALA_PYTHON=C:/path/to/python.exe
